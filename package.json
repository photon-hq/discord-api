{
  "name": "discord-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.19",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate:openapi": "bun scripts/generate-discord-openapi.ts",
    "generate:client": "bun --filter @photon-ai/discord-ts generate",
    "build": "bun --filter @photon-ai/discord-ts build",
    "typecheck": "tsc --noEmit && bun --filter @photon-ai/discord-ts typecheck",
    "test": "bun --filter @photon-ai/discord-ts test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "compute:version": "bun scripts/compute-version.ts",
    "diff:surface": "bun scripts/api-surface-diff.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "ultracite": "7.8.2"
  }
}
