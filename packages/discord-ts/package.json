{
  "name": "@photon-ai/discord-ts",
  "version": "10.0.0",
  "description": "A typed TypeScript client with Zod schemas for the Discord HTTP API, generated from the official OpenAPI spec.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/discord-api.git",
    "directory": "packages/discord-ts"
  },
  "homepage": "https://github.com/photon-hq/discord-api/tree/main/packages/discord-ts",
  "keywords": [
    "discord",
    "discord-api",
    "openapi",
    "typescript",
    "zod",
    "client",
    "sdk"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "openapi-ts",
    "prebuild": "openapi-ts",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
